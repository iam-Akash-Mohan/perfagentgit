      "file": "src/main/java/com/ex/repo/PaymentAllocationRepository.java",
      "line": 19,
      "sql": "select new com.ex.dto.CollectionsRowDto(c.name, i.id, p.paidOn, pa.allocatedAmount) from PaymentAllocation pa, CustomerPayment p, Invoice i, Customer c where pa.paymentId = p.id and pa.invoiceId = i.id and i.customer.id = c.id and FUNCTION('DATE', p.paidOn) >= :from and FUNCTION('DATE', p.paidOn) < :to and p.method = :method order by p.paidOn asc, p.id asc",
      "tables": [
        "payment_allocation",
        "customer_payment",
        "invoice",
        "customer"
      ],
