      "line": 29,
      "sql": "select i.amount, i.status, pa.id, p.paid_on, pa.allocated_amount, p.method from invoice i left join payment_allocation pa on pa.invoice_id = i.id left join customer_payment p on p.id = pa.payment_id where i.id = ? order by p.paid_on asc, p.id asc, pa.id asc",
      "tables": [
        "invoice",
        "payment_allocation",
        "customer_payment"
      ],
      "executes_per_row": false,
      "note": "select new com.ex.dto.InvoiceAllocationRowDto(i.amount, i.status, pa.id, p.paidOn, pa.allocatedAmount, p.method) from Invoice i left join PaymentAllocation pa on pa.invoiceId = i.id left join CustomerPayment p on p.id = pa.paymentId where i.id = :invoiceId order by p.paidOn asc, p.id asc, pa.id asc"
    }
